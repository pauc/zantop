# Secrets referenced by config/deploy.yml under registry/password and
# env/secret. This file is committed, so it may only ever read values, never
# contain them.
#
# Locally, export the values below before running kamal (direnv, a password
# manager, whatever you prefer). In CI they come from the repository secrets
# wired up in .github/workflows/deploy.yml.

# A GitHub personal access token with write:packages. The deploy workflow
# passes the automatic GITHUB_TOKEN instead.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Signs cookies and every other MessageVerifier in the app. Set directly
# rather than decrypted out of Rails credentials: the key for the old
# config/credentials/production.yml.enc is gone, and that file held nothing
# else once the database credentials moved into the environment. Generate one
# with `rails secret` and keep it somewhere durable — losing it invalidates
# every signed cookie and signed ActiveStorage URL.
SECRET_KEY_BASE=$SECRET_KEY_BASE

# One password, two consumers: the app connects with it through
# config/database.yml, and the Postgres accessory is created with it. They have
# to agree, so they are deliberately the same value under two names.
ZANTOP_DATABASE_PASSWORD=$ZANTOP_DATABASE_PASSWORD
POSTGRES_PASSWORD=$ZANTOP_DATABASE_PASSWORD

# The SMTP account config/environments/production.rb delivers the contact form
# through. Not in Rails credentials on purpose: there are none, and production.rb
# is loaded by assets:precompile, so a credentials read would need the master key
# at image build time. Port and HELO domain are not secret and sit in
# config/deploy.yml instead.
ZANTOP_SMTP_ADDRESS=$ZANTOP_SMTP_ADDRESS
ZANTOP_SMTP_USER_NAME=$ZANTOP_SMTP_USER_NAME
ZANTOP_SMTP_PASSWORD=$ZANTOP_SMTP_PASSWORD
