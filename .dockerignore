# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for
# more about ignoring files.

# Git
.git/
.gitattributes
.github/
.gitignore

# Bundler and node dependencies, reinstalled inside the image
/.bundle/
/node_modules/
/vendor/bundle/
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Generated by the build itself
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets
/public/packs
/public/packs-test

# Runtime state that must not be baked into the image
/log/*
/tmp/*
/uploads/
/storage/*

# Never ship the keys that decrypt the credentials
/config/master.key
/config/credentials/*.key

# Development and deployment tooling with no place in the image
/.claude/
/.envrc
/.kamal/
/.mutant/
/.playwright-mcp/
/.ruby-lsp/
/spec/
/Capfile
/Guardfile
/config/deploy.rb
/config/deploy/
/docker-compose.yml
/Procfile.dev

# Historical CarrierWave files: 112MB of tracked images that `rake
# migrate_images` reads once, during the cutover. Keeping them out of the image
# keeps it small; the one-off run needs them bind-mounted in instead.
/legacy_uploads/
