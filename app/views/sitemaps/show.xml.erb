<?xml version="1.0" encoding="UTF-8"?>
<%#
  One <url> per locale per page, each one carrying the alternates for all
  three plus x-default — the sitemap equivalent of the rel=alternate links in
  the page's own <head>, and the protocol wants them repeated on every member
  of the set rather than declared once.

  <lastmod> where the page has a date and nowhere else — the dates themselves
  are `Sitemap`'s to work out. It goes between <loc> and the alternates
  because the schema says so: sitemap.xsd sequences loc, lastmod, changefreq
  and priority, and only then admits elements from another namespace.

  The three URLs of a page all carry the same date, since `updated_at` moves
  whichever locale was written. Translating a work's title into English
  therefore re-dates its Catalan URL too. That is the harmless direction to
  err in, and it is arguably not an error at all: the set of alternates this
  <url> declares did just change.

  No <changefreq> or <priority>: nothing reads them.
%>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
<% @sitemap.entries.each do |entry| %>
<% urls = alternate_urls(entry.record, path_parameters: entry.path_parameters) %>
<% urls.each_value do |url| %>
  <url>
    <loc><%= url %></loc>
<% if entry.lastmod %>
    <lastmod><%= entry.lastmod.utc.iso8601 %></lastmod>
<% end %>
<% urls.each do |locale, alternate| %>
    <xhtml:link rel="alternate" hreflang="<%= locale %>" href="<%= alternate %>"/>
<% end %>
    <xhtml:link rel="alternate" hreflang="x-default" href="<%= urls.fetch(MetadataHelper::X_DEFAULT_LOCALE) %>"/>
  </url>
<% end %>
<% end %>
</urlset>
