<%= page_title "Ordenar treballs" %>

<p class="sorting-hint">
  Arrossega els treballs, o fes servir les fletxes de cada fila, per canviar-ne
  l'ordre. Es desa tot sol.
</p>

<%# Two regions rather than one: a move and the save that follows it are
    separate announcements, and writing both into the same live region would
    have the second cut the first off before a screen reader finished it. %>
<p class="sorting-status">
  <span role="status" data-behaviour="sorting-position"></span>
  <span role="status" data-behaviour="sorting-save"></span>
</p>

<ul class="sortable-list"
    data-behaviour="sortable-works"
    data-url="<%= sort_works_path %>">
  <% @works.each do |work| %>
    <li class="sortable-item <%= "unpublished" unless work.published? %>"
        draggable="true"
        data-id="<%= work.id %>">
      <span class="handle" aria-hidden="true">⣿</span>

      <span class="sorting-controls">
        <button type="button"
                class="btn-move"
                data-behaviour="move-up"
                aria-label="Mou «<%= work.title %>» amunt">⬆️</button>
        <button type="button"
                class="btn-move"
                data-behaviour="move-down"
                aria-label="Mou «<%= work.title %>» avall">⬇️</button>
      </span>

      <%= link_to work.title, work, class: "work-title" %>

      <% unless work.published? %>
        <span class="unpublished-note">(no publicat)</span>
      <% end %>

      <span class="translations-info">
        <% I18n.available_locales.each do |locale| %>
          <span class="<%= work.translated_into?(locale) ? "translated" : "untranslated" %>">
            <%= locale %>
          </span>
        <% end %>
      </span>

      <%= link_to "Editar", url_for_edit_work(work), class: "push-right btn btn-smaller" %>
    </li>
  <% end %>
</ul>
