<%= page_title @page.title %>
<%# The description says what the page is for, which the editable intro below
    is free to stop doing, so it stays a translation rather than the body. %>
<% page_metadata description: t("meta.descriptions.contact") %>

<%= @page.body %>

<%= simple_form_for @contact_message do |f| %>
  <%= error_summary f %>
  <%= f.input :from_email %>
  <%= f.input :from_name %>
  <%= f.input :subject%>
  <%= f.input :text, as: :text, input_html: { cols: 20, rows: 9 } %>
  <%= f.button :submit, value: t('simple_form.labels.contact_message.send') %>
<% end %>
