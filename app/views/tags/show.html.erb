<%= page_title @category.name.capitalize %>
<% page_metadata description: t("meta.descriptions.tag", category: @category.name),
                 record: @category %>

<%# The cache key carries who is looking, because the list inside it does: the
    owner is served her unpublished works here, and without this the copy she
    leaves behind would be served to the next anonymous visitor. %>
<% cache [I18n.locale, :show, @category, current_user?] do %>
  <div class="works-list">
    <%= render partial: 'works/work_preview', collection: @works, as: :work %>
  </div>
<% end %>
